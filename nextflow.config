manifest {
    name            = 'metion'
    description     = 'Bacterial DNA methylation (6mA, 5mC, 4mC) from Oxford Nanopore reads'
    author          = 'Mario García Calleja'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}

params {
    // Inputs
    samplesheet = null          // CSV: sample,barcode,bam,bedmethyl (see README)
    comparisons = null          // CSV: comparison,control,treated
    pod5        = null          // directory with .pod5 files (only when basecalling)
    reference   = null          // reference genome FASTA
    regions     = null          // BED of regions of interest (genes, promoters...)
    outdir      = 'results'

    // Dorado basecalling
    dorado_bin            = 'dorado'
    dorado_model          = 'hac'                 // model name, complex or path to a model directory
    dorado_modified_bases = '6mA 4mC_5mC'         // all-context bacterial models (downloaded by dorado)
    dorado_mod_models     = null                  // comma-separated paths to local modification models (overrides the above)
    dorado_kit            = 'SQK-RBK114-24'
    dorado_device         = 'cuda:all'
    dorado_args           = ''

    // modkit
    ignore_mods = 'h'           // codes removed with `modkit adjust-mods` before pileup ('none' to keep all)
    pileup_args = ''            // extra arguments, e.g. "--motif GATC 1" or "--combine-strands"
    dmr_bases   = 'A,C'         // primary bases compared by `modkit dmr pair`

    // Statistics and annotation
    fdr          = 0.05         // Benjamini-Hochberg threshold on the per-site MAP p-value
    min_effect   = 0.2          // minimum |difference in fraction modified|
    min_coverage = 5            // minimum valid coverage in both samples
    flank        = 200          // bp upstream of each region also reported
    legacy       = false        // reproduce the original TFG filtering (score > 0, gene body only)

    slurm_queue = null
}

includeConfig 'conf/base.config'

profiles {
    test {
        params.samplesheet = "${projectDir}/tests/data/samplesheet.csv"
        params.comparisons = "${projectDir}/tests/data/comparisons.csv"
        params.reference   = "${projectDir}/tests/data/reference.fasta"
        params.regions     = "${projectDir}/tests/data/regions.bed"
        process.resourceLimits = [cpus: 2, memory: '4.GB']
        params.min_coverage = 3
    }
}
